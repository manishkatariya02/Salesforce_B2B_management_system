<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>available_stock_value</fullName>
    <active>true</active>
    <description>the stock values must be proper</description>
    <errorConditionFormula>Available_quantity__c &lt; 0 &amp;&amp; ISBLANK (Available_quantity__c)</errorConditionFormula>
    <errorDisplayField>Available_quantity__c</errorDisplayField>
    <errorMessage>Please enter the valid quantity</errorMessage>
</ValidationRule>
